<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE ONLY, installed by nobody: the weekly tier-1 watcher scan (feeds; the quarantined Reader runs here when watch_reader is on), run by the
     second user `acewatch` on Sundays at 05:00 (docs/watch/SANDBOX.md). Same two __PLACEHOLDERS__ as com.example.acewatch.plist (the copy is
     a full checkout with a .venv built from a python outside any user home); the same install and remove steps
     (`launchctl bootout system/com.example.acewatch.weekly`). Like the daily job it runs through hooks/acewatch/acewatch_run.py, which opens this
     job's two log files itself as acewatch, runs the scan and rotates them (docs/watch/SANDBOX.md "Log rotation"). No StandardOutPath and no
     StandardErrorPath on purpose: launchd opens no file anywhere. A wrapper that cannot start at all (a missing copy)
     leaves only its last exit status in `sudo launchctl print system/com.example.acewatch.weekly` (not checked on a real install); a refused log is exit
     status 3 with the reason in the err log, else the out log, else only that exit status. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.acewatch.weekly</string>
  <key>UserName</key>
  <string>acewatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ACE_PLAYBOOK_COPY__/.venv/bin/python</string>
    <string>-I</string>
    <string>__ACE_PLAYBOOK_COPY__/hooks/acewatch/acewatch_run.py</string>
    <string>__ACEWATCH_HOME__/logs</string>
    <string>acewatch.weekly.out.log</string>
    <string>acewatch.weekly.err.log</string>
    <string>--</string>
    <string>__ACE_PLAYBOOK_COPY__/.venv/bin/python</string>
    <string>-m</string>
    <string>ace_playbook.compile</string>
    <string>watch</string>
    <string>scan</string>
    <string>--tier</string>
    <string>1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ACE_PLAYBOOK_COPY__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ACE_PLAYBOOK_CONFIG</key>
    <string>__ACEWATCH_HOME__/.config/ace-playbook/config.json</string>
    <key>HOME</key>
    <string>__ACEWATCH_HOME__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
